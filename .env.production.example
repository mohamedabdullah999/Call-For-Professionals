# Settings for docker-compose.prod.yml (local, production-like run): cp .env.production.example .env
# The company server does not use this file: its env lives in the root-only file read by the
# systemd service (variables listed in docs/DEPLOY.md). Never commit real values.

# PostgreSQL (container only, not exposed). Use letters and digits only, since it goes into a URL.
POSTGRES_USER=elksa
POSTGRES_DB=elksa_landing
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Salt for hashing visitor IPs. Generate with: openssl rand -hex 32
IP_HASH_SALT=

# Public URL, base path included, no trailing slash. Baked in at build time.
NEXT_PUBLIC_SITE_URL=https://global.expertslive.sa/speakerreg
# Sub-path the site is served under. Baked in at build time.
NEXT_PUBLIC_BASE_PATH=/speakerreg
