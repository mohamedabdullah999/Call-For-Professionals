# Production settings for docker-compose.prod.yml.
# On the server: cp .env.production.example .env  → fill in the values → chmod 600 .env
# Keep the file name .env (it is git- and docker-ignored). Never commit real values.

# PostgreSQL (container only, not exposed). Use letters and digits only, since it goes into a URL.
POSTGRES_USER=elksa
POSTGRES_DB=elksa_landing
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Salt for hashing visitor IPs. Generate with: openssl rand -hex 32
IP_HASH_SALT=

# Public URL, base path included, no trailing slash. Baked in at build time.
NEXT_PUBLIC_SITE_URL=https://global.expertslive.sa/speakerreg
# Sub-path behind nginx. Must match the `location` in deploy/nginx-speakerreg.conf. Baked in at build time.
NEXT_PUBLIC_BASE_PATH=/speakerreg
