# PostgreSQL connection used by the form API and the migration/export scripts
DATABASE_URL=postgres://elksa:elksa@localhost:5433/elksa_landing

# Random string used to hash visitor IPs before they are stored (never store raw IPs)
IP_HASH_SALT=change-me-to-a-long-random-string

# Public URL of the site, base path included, no trailing slash. Read at build time
# (canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000/speakerreg

# Sub-path the site is served under. Unset = /speakerreg. Set it empty to serve from the root
# (then also drop /speakerreg from NEXT_PUBLIC_SITE_URL). Read at build time.
NEXT_PUBLIC_BASE_PATH=/speakerreg

# How many reverse proxies sit in front of the app (used to read the real client IP for rate limiting)
TRUSTED_PROXY_HOPS=1
